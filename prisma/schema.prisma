// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// Items catalog
model Item {
  id        String   @id @default(cuid())
  code      String   @unique
  desc      String
  price     Float
  customer  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customer])
  @@index([code])
}

// Contacts/Customers
model Contact {
  id        String   @id @default(cuid())
  name      String
  account   String   @unique
  email     String
  alias     String[] // Array of alias strings for fuzzy matching
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poRules   PoRule[]

  @@index([account])
}

// Jobs/Purchase Orders
model Job {
  id                String   @id
  po_number         String   @unique
  customer_name     String
  customer_account  String
  customer_email    String
  customer_contact  String
  parts             Json     // Array of IPart objects
  plating           String
  weightKg          Float
  stringCount       Int
  stringsRequired   Boolean
  requiresWeighing  Boolean
  freightRequested  Boolean
  minCharge         Boolean
  flagged           Boolean
  notes             String
  poPages           String[] @default([])
  partsOnArrivalPhotos String[] @default([])
  manualPO          Boolean
  urgent            Boolean
  isInternal        Boolean
  isRework          Boolean
  partDescription   String
  createdAt         BigInt   // Storing as timestamp in ms
  priceOverride     Float?
  freightCost       Float
  dispatchedAt      BigInt?
  invoiceNumber     String?
  poComplete        Boolean  @default(false)
  fpnDownloaded     Boolean  @default(false)
  fpnHidden         Boolean  @default(false)
  csvDownloaded     Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  createdByUserId   String?  // Clerk user id of the staff member who created the job

  jigAssignments    JigAssignment[]

  @@index([po_number])
  @@index([customer_account])
  @@index([poComplete])
  @@index([dispatchedAt])
  @@index([createdByUserId])
}

// Jig Assignment Status
enum JigAssignmentStatus {
  ACTIVE    // Currently on the jig
  CLEARED   // Completed and cleared from jig
}

// Jig — a physical numbered slot (e.g. "JIG-01") that jobs get loaded onto.
// A stable id, not the display name, is what everything else joins on.
model Jig {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currentPhotoId String?

  assignments JigAssignment[]
  photos      JigPhoto[]         @relation("JigPhotos")
  currentPhoto JigPhoto?         @relation("JigCurrentPhoto", fields: [currentPhotoId], references: [id], onDelete: SetNull)
  rework      JigRework?

  @@index([currentPhotoId])
}

// Jig Assignments
model JigAssignment {
  id          String              @id
  jobId       String
  jigId       String
  pct         Float
  pic         String?             // Deprecated — superseded by photoId, kept unused for rollback safety
  photoId     String?
  completedAt BigInt?             // Timestamp in ms when cleared
  loadedAt    BigInt              // Timestamp in ms when loaded
  status      JigAssignmentStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  job         Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jig         Jig                 @relation(fields: [jigId], references: [id], onDelete: Cascade)
  photo       JigPhoto?           @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([jigId])
  @@index([status])
  @@index([photoId])
  @@index([jigId, status])
  @@index([jobId, status])
}

// Settings (singleton table)
model Settings {
  id           Int    @id @default(1)
  silverKg     Float
  goldKg       Float
  silverJig    Float
  goldJig      Float
  silverMinCharge Float @default(60)
  goldMinCharge   Float @default(70)
  dueDays      Int
  jigCount     Int
  invSeqStart  Int
  stringRate   Float
  invSeq       Int    @default(1) // Current invoice sequence
  updatedAt    DateTime @updatedAt
}

// Jig Photos (storing jig images) — append-only, one row per load cycle,
// never deleted. Jig.currentPhotoId is the only thing that says whether a
// row is "live" right now — it's set when a photo is uploaded and cleared
// (set to null) when the jig completes or empties out, disassociating the
// row from the jig without deleting it. Rows also stay around as
// permanent history for whichever JigAssignments reference them via
// photoId, entirely independent of currentPhotoId.
model JigPhoto {
  id        String   @id @default(cuid())
  jigId     String
  photoData String   // Base64 or URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jig             Jig             @relation("JigPhotos", fields: [jigId], references: [id], onDelete: Cascade)
  assignments     JigAssignment[]
  currentForJigs  Jig[]           @relation("JigCurrentPhoto")

  @@index([jigId])
}

// Jig Rework flag — marks the unfilled remainder of a jig as rework so it
// can be completed below 100% loaded. Reset to false whenever the jig is
// marked complete, so the next load cycle starts clean.
model JigRework {
  id        String   @id @default(cuid())
  jigId     String   @unique
  isRework  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jig       Jig      @relation(fields: [jigId], references: [id], onDelete: Cascade)
}

// Staff accounts (passkey authentication)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials Credential[]
  sessions    Session[]

  @@index([email])
  @@index([role])
}

// WebAuthn passkey credentials
model Credential {
  id           String   @id @default(cuid())
  credentialId String   @unique
  userId       String
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  deviceType   String
  backedUp     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Staff invitations — admin-created, accepted via passkey registration
model Invitation {
  id         String    @id @default(cuid())
  email      String
  role       String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([token])
}

// DB-backed sessions — deleting a row instantly revokes access
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// PO Scanning Rules (customer-specific PO scanning configurations)
model PoRule {
  id             Int      @id @default(autoincrement())
  contactAccount String
  ruleType       String
  scanningRules  String
  priority       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contact        Contact  @relation(fields: [contactAccount], references: [account], onDelete: Cascade)

  @@index([contactAccount])
  @@index([contactAccount, priority])
}
